    SettingsSection {
        Layout.fillWidth: true
        Layout.fillHeight: expanded
        Layout.alignment: Qt.AlignTop
        Layout.minimumWidth: 0
        collapsible: true
        sectionNumber: {{ section_number }}
        iconSource: {{ icon }}
{% if full_width %}
        Layout.columnSpan: settingsPage.columnCount
{% endif %}
{% if heading %}
        heading: {{ heading }}
{% endif %}
{% if heading_description %}
        headingDescription: {{ heading_description }}
{% endif %}
        visible: {{ visible }}
{% if enable_when %}
        enabled: {{ enable_when }}
{% endif %}

{% for block in blocks %}
{{ block }}
{% if not loop.last %}

{% endif %}
{% endfor %}
    }
