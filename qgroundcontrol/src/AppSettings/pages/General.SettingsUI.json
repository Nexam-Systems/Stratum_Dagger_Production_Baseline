{
    "version": 1,
    "fileType": "SettingsUI",
    "title": "General Settings",
    "description": "Configure application preferences and operational parameters",
    "bindings": {
        "_appSettings": "QGroundControl.settingsManager.appSettings"
    },
    "groups": [
        {
            "heading": "STRATUM",
            "keywords": ["stratum", "profile", "dropper", "dagger", "vehicle", "mode"],
            "showWhen": "false",
            "controls": [
                {
                    "setting": "appSettings.stratumProfile",
                    "control": "combobox"
                }
            ]
        },
        {
            "heading": "Operational Limits",
            "sectionNumber": "01",
            "icon": "/InstrumentValueIcons/tuning.svg",
            "keywords": ["stratum", "standoff", "aop", "area of operations", "limit", "distance", "max"],
            "controls": [
                {
                    "setting": "flyViewSettings.maxGoToLocationDistance"
                },
                {
                    "setting": "flyViewSettings.maxAOPDistance"
                }
            ]
        },
        {
            "heading": "User Interface",
            "sectionNumber": "02",
            "icon": "/InstrumentValueIcons/computer-desktop.svg",
            "keywords": ["language", "locale", "color theme", "color scheme", "high contrast", "normal", "dark mode", "theme", "palette", "ui scale", "font size", "zoom"],
            "controls": [
                {
                    "setting": "appSettings.qLocaleLanguage",
                    "control": "combobox"
                },
                {
                    "setting": "appSettings.indoorPalette"
                },
                {
                    "setting": "appSettings.uiScalePercent",
                    "control": "scaler"
                }
            ]
        },
        {
            "heading": "Position Streaming",
            "sectionNumber": "03",
            "icon": "/InstrumentValueIcons/location.svg",
            "keywords": ["follow me", "position", "stream", "gcs"],
            "controls": [
                {
                    "setting": "appSettings.followTarget"
                }
            ]
        },
        {
            "heading": "Audio",
            "sectionNumber": "04",
            "icon": "/InstrumentValueIcons/volume-up.svg",
            "keywords": ["audio", "volume", "sound", "mute", "test"],
            "controls": [
                {
                    "setting": "appSettings.audioVolume",
                    "control": "slider",
                    "enableCheckbox": {
                        "checked": "!_appSettings.audioMuted.rawValue",
                        "onClicked": "{ if (enableCheckBoxChecked && _appSettings.audioVolume.rawValue <= 0) _appSettings.audioVolume.rawValue = 75; _appSettings.audioMuted.rawValue = !enableCheckBoxChecked }"
                    },
                    "button": {
                        "text": "Test",
                        "onClicked": "QGroundControl.testAudioOutput()",
                        "enabled": "!_appSettings.audioMuted.rawValue && _appSettings.audioVolume.rawValue > 0"
                    }
                }
            ]
        },
        {
            "heading": "Application",
            "sectionNumber": "05",
            "icon": "/InstrumentValueIcons/servers.svg",
            "fullWidth": true,
            "keywords": ["save path", "storage", "reset", "clear settings", "factory reset"],
            "controls": [
                {
                    "setting": "appSettings.androidDontSaveToSDCard",
                    "showWhen": "ScreenTools.isMobile"
                },
                {
                    "setting": "appSettings.savePath",
                    "control": "browse",
                    "showWhen": "!ScreenTools.isMobile"
                },
                {
                    "setting": "appSettings.clearSettingsNextBoot"
                }
            ]
        },
        {
            "heading": "Vehicle Preferences",
            "keywords": ["firmware", "ardupilot", "px4", "vehicle", "multirotor", "fixed wing", "vtol", "rover", "sub"],
            "controls": [
                {
                    "setting": "appSettings.preferredFirmwareClass",
                    "control": "combobox"
                },
                {
                    "setting": "appSettings.preferredVehicleClass",
                    "control": "combobox"
                }
            ]
        },
        {
            "heading": "Units",
            "keywords": ["units", "metric", "imperial", "distance", "speed", "area", "temperature", "feet", "meters"],
            "showWhen": "QGroundControl.settingsManager.unitsSettings.userVisible",
            "controls": [
                {
                    "setting": "unitsSettings.horizontalDistanceUnits",
                    "control": "combobox"
                },
                {
                    "setting": "unitsSettings.verticalDistanceUnits",
                    "control": "combobox"
                },
                {
                    "setting": "unitsSettings.areaUnits",
                    "control": "combobox"
                },
                {
                    "setting": "unitsSettings.speedUnits",
                    "control": "combobox"
                },
                {
                    "setting": "unitsSettings.temperatureUnits",
                    "control": "combobox"
                }
            ]
        }
    ]
}
